{
  "name": "cuu-meo",
  "version": "0.1.0",
  "description": "Một chạm để né ong, cứu chú mèo. Điểm tăng dần theo thời gian và mỗi lần né thành công!",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node -e \"require('fs').copyFileSync('playgama-bridge-config.json', 'dist/playgama-bridge-config.json')\"",
    "build:web": "vite build && node -e \"require('fs').copyFileSync('playgama-bridge-config.json', 'dist/playgama-bridge-config.json')\"",
    "build:playgama": "vite build && node -e \"require('fs').copyFileSync('playgama-bridge-config.json', 'dist/playgama-bridge-config.json')\"",
    "build:standalone": "vite build",
    "typecheck": "tsc --noEmit",
    "test:types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@game/sdk": "workspace:*",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.6.0",
    "jsdom": "^24.0.0"
  }
}
