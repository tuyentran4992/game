{
  "name": "deepcast",
  "version": "0.1.0",
  "description": "Deep Cast: one-finger push-your-luck dive fishing. Catch the Blue Whale to win.",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5199 --strictPort",
    "typecheck": "tsc --noEmit",
    "test:types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "node --experimental-strip-types scripts/sim.ts",
    "check-manifest": "node --experimental-strip-types scripts/check-manifest.ts",
    "build": "vite build && node -e \"require('fs').copyFileSync('playgama-bridge-config.json', 'dist/playgama-bridge-config.json')\""
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.6.0"
  }
}
