{
  "name": "juicymerge",
  "version": "0.1.0",
  "description": "Juicy Merge: Fruit Pop — Universal physics merge puzzle game for Reddit Devvit, Playgama, and Web",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "dev:reddit": "devvit playtest r/JuicyMerge",
    "build": "npm run build:reddit",
    "build:web": "vite build --mode web && node -e \"require('fs').copyFileSync('playgama-bridge-config.json', 'dist/playgama-bridge-config.json')\"",
    "build:reddit": "vite build --mode reddit",
    "package:playgama": "npm run build:web && python tools/package-playgama.py",
    "deploy:reddit": "npm run test:types && npm run lint && devvit upload",
    "launch:reddit": "npm run deploy:reddit && devvit publish",
    "lint": "eslint src",
    "prettier": "prettier --write .",
    "test:types": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@devvit/start": "^0.14.0",
    "@devvit/web": "^0.14.0",
    "@hono/node-server": "^2.1.0",
    "devvit": "^0.14.0",
    "hono": "^4.13.0",
    "phaser": "^3.80.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.0.0",
    "globals": "^17.0.0",
    "jsdom": "^24.0.0",
    "prettier": "^3.9.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.0.0",
    "vitest": "^1.6.0"
  }
}