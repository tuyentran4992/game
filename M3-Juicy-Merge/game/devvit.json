{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "juicymerge",
  "dev": {
    "subreddit": "JuicyMerge"
  },
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "preview.html"
      },
      "game": {
        "entry": "index.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Play Juicy Merge",
        "description": "Drop fruits, merge them, grow bigger!",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      }
    ]
  },
  "scripts": {
    "build": "vite build --mode reddit",
    "dev": "vite build --mode reddit --watch"
  }
}